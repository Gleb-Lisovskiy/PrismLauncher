msgid "Downloading %1"
msgstr "Загрузка: %1"

msgctxt "LibraryDownloadTask"
msgid "The download failed."
msgstr "Загрузка не удалась."

msgctxt "LibraryDownloadTask"
msgid "The file has no download link. Open the project page and add the file from disk."
msgstr "У файла нет ссылки на загрузку. Откройте страницу проекта и добавьте файл с диска."

msgctxt "LibraryDownloadTask"

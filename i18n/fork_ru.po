msgstr "Не удалось записать %1: %2"

msgctxt "ModConflictsDialog"
msgid "\"%1\" is built for %2, while the instance runs %3."
msgstr "«%1» собран под %2, а инстанс запускает %3."

msgctxt "ModConflictsDialog"
msgid "\"%1\" is marked for Minecraft %2, not for %3."
msgstr "«%1» отмечен для Minecraft %2, а не для %3."

msgctxt "ModConflictsDialog"
msgid "\"%1\" needs the mod \"%2\", which is not installed."
msgstr "«%1» требует мод «%2», который не установлен."

msgctxt "ModConflictsDialog"
msgid "\"%1\" needs the mod \"%2\", which is switched off."
msgstr "«%1» требует мод «%2», который выключен."


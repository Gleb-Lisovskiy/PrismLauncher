msgctxt "LauncherPage"
msgid "&Local Files:"
msgstr "&Локальные файлы:"

msgctxt "LauncherPage"
msgid "Folder holding mods, resource packs, texture packs and shader packs you keep across instances. Anything dropped into it shows up under the 'Local Files' tab of the corresponding download dialog; a markdown file named after a file, with a .md suffix, describes it."
msgstr "Папка с модами, ресурспаками, текстурпаками и шейдерпаками, общими для всех инстансов. Всё, что в неё положено, появляется на вкладке «Локальные файлы» в окне загрузки; файл markdown с тем же именем и суффиксом .md описывает ресурс."

msgctxt "LauncherPage"
msgid "Local Files Folder"
msgstr "Папка локальных файлов"

msgctxt "LibraryDownloadTask"
msgid "Could not create a temporary folder for the download."
msgstr "Не удалось создать временную папку для загрузки."

msgctxt "LibraryDownloadTask"
msgid "Could not stage the downloaded file."
msgstr "Не удалось подготовить загруженный файл."

msgctxt "LibraryDownloadTask"
msgid "Downloading %1"
msgstr "Загрузка: %1"

msgctxt "LibraryDownloadTask"
msgid "The download failed."
msgstr "Загрузка не удалась."

msgctxt "LibraryDownloadTask"
msgid "The file has no download link. Open the project page and add the file from disk."
msgstr "У файла нет ссылки на загрузку. Откройте страницу проекта и добавьте файл с диска."

msgctxt "LibraryDownloadTask"
msgid "The library is not available."
msgstr "Библиотека недоступна."

msgctxt "LocalResourceCopyTask"
msgid "Copying %1"
msgstr "Копирование: %1"

msgctxt "LocalResourceCopyTask"
msgid "Could not read %1: %2"
msgstr "Не удалось прочитать %1: %2"

msgctxt "LocalResourceCopyTask"
msgid "Could not write %1: %2"
msgstr "Не удалось записать %1: %2"

msgctxt "ModFolderPage"
msgid "Get mods from your local files folder or from online mod platforms"
msgstr "Взять моды из папки локальных файлов или с онлайн-платформ"

msgctxt "QObject"
msgid "Could not copy %1 into the library"
msgstr "Не удалось скопировать %1 в библиотеку"

msgctxt "QObject"
msgid "Could not create the library directory: %1"
msgstr "Не удалось создать папку библиотеки: %1"

msgctxt "QObject"
msgid "No such file: %1"
msgstr "Нет такого файла: %1"

msgctxt "QObject"
msgid "The local files folder cannot be read: %1"
msgstr "Не удалось прочитать папку локальных файлов: %1"

msgctxt "ResourceDownload::LocalModPage"
msgid "Local Files"
msgstr "Локальные файлы"

msgctxt "ResourceDownload::LocalResourcePackPage"
msgid "Local Files"
msgstr "Локальные файлы"

msgctxt "ResourceDownload::LocalShaderPackPage"
msgid "Local Files"
msgstr "Локальные файлы"

msgctxt "ResourceDownload::LocalTexturePackPage"
msgid "Local Files"
msgstr "Локальные файлы"

msgctxt "ResourceDownload::ModModel"
msgid "A network error occurred. Could not load project versions: %1"
msgstr "Ошибка сети. Не удалось загрузить версии проекта: %1"

msgctxt "ResourceDownload::ResourcePage"
msgid "'%1' does not allow downloads from third-party launchers and no project page is known."
msgstr "«%1» не разрешает загрузку сторонними лаунчерами, и страница проекта неизвестна."

msgctxt "ResourceDownload::ResourcePage"
msgid "'%1' is now in your local files. It appears under the 'Local Files' tab whenever you install mods, resource packs or shader packs into an instance."
msgstr "«%1» теперь в локальных файлах. Он появится на вкладке «Локальные файлы», когда вы ставите моды, ресурспаки или шейдерпаки в инстанс."

msgctxt "ResourceDownload::ResourcePage"
msgid "Added to Local Files"
msgstr "Добавлено в локальные файлы"

msgctxt "ResourceDownload::ResourcePage"
msgid "Install an incompatible version?"
msgstr "Установить несовместимую версию?"

msgctxt "ResourcePackPage"
msgid "Get resource packs from your local files folder or from online mod platforms"
msgstr "Взять ресурспаки из папки локальных файлов или с онлайн-платформ"

msgctxt "ResourcePage"
msgid "Download this version into your local files folder, where it can be installed into any instance later without downloading it again."
msgstr "Скачать эту версию в папку локальных файлов, чтобы потом ставить её в любой инстанс без повторной загрузки."

msgctxt "ResourcePage"
msgid "Save to Local Files"
msgstr "Сохранить в локальные файлы"

msgctxt "ShaderPackPage"
msgid "Get shader packs from your local files folder or from online mod platforms"
msgstr "Взять шейдерпаки из папки локальных файлов или с онлайн-платформ"

msgctxt "TexturePackPage"
msgid "Get texture packs from your local files folder or from online mod platforms"
msgstr "Взять текстурпаки из папки локальных файлов или с онлайн-платформ"
